{
  "name": "trustvault",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src tests prisma",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:setup": "node scripts/init-db.mjs && prisma generate && prisma db push && tsx prisma/seed.ts"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@prisma/client": "6.19.0",
    "zod": "^4.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "4.1.18",
    "@tailwindcss/postcss": "4.1.18",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.4"
  },
  "type": "module"
}
